msgid "A column title is too long."
msgstr "Eine Spaltenüberschrift ist zu lang."

#: pretix_custom_reports/views/editor.py:226
msgid "A filter is missing its value."
msgstr "Einem Filter fehlt sein Wert."

#: pretix_custom_reports/views/editor.py:227
msgid "A report needs at least one column."
msgstr "Eine Auswertung braucht mindestens eine Spalte."

#: pretix_custom_reports/views/editor.py:228
msgid "A field used for sorting is not sortable."
msgstr "Ein Feld, nach dem sortiert wird, ist nicht sortierbar."

#: pretix_custom_reports/views/editor.py:230
msgid "An operator is not allowed for its field."
msgstr "Ein Operator ist für sein Feld nicht erlaubt."

#: pretix_custom_reports/views/editor.py:232
msgid "Too many columns."
msgstr "Zu viele Spalten."

#: pretix_custom_reports/views/editor.py:233
msgid "Too many sorting stages."
msgstr "Zu viele Sortierstufen."

#: pretix_custom_reports/views/editor.py:234
msgid "Too many values in one filter."
msgstr "Zu viele Werte in einem Filter."

#: pretix_custom_reports/views/editor.py:236
msgid "This page has unsaved changes that will be lost. Continue?"
msgstr ""
"Diese Seite hat ungespeicherte Änderungen, die verloren gehen. Fortfahren?"

#: pretix_custom_reports/views/editor.py:239
msgid ""
"This page has unsaved changes. The file will contain the saved version, not "
"your current changes. Continue?"
msgstr ""
"Diese Seite hat ungespeicherte Änderungen. Die Datei enthält den "
"gespeicherten Stand, nicht Ihre aktuellen Änderungen. Fortfahren?"

#: pretix_custom_reports/views/editor.py:242
msgid "No field matches your search."
msgstr "Kein Feld passt zu Ihrer Suche."

#: pretix_custom_reports/views/editor.py:243
msgid "The editor could not be loaded."
msgstr "Der Editor konnte nicht geladen werden."

#: pretix_custom_reports/views/editor.py:244
msgid "Move down"
msgstr "Nach unten"

#: pretix_custom_reports/views/editor.py:245
msgid "Move up"
msgstr "Nach oben"

#: pretix_custom_reports/views/editor.py:246
msgid "Select one or more values."
msgstr "Wählen Sie einen oder mehrere Werte."

#: pretix_custom_reports/views/editor.py:248
msgid "no values yet"
msgstr "noch keine Werte"

#: pretix_custom_reports/views/editor.py:249
msgid "No preview: the report is not valid yet."
msgstr "Keine Vorschau: Die Auswertung ist noch nicht gültig."

#: pretix_custom_reports/views/editor.py:251
msgid "Complete the highlighted entries to refresh the preview."
msgstr ""
"Vervollständigen Sie die hervorgehobenen Einträge, um die Vorschau zu "
"aktualisieren."

#: pretix_custom_reports/views/editor.py:253
msgid "preview limited to %(limit)s rows"
msgstr "Vorschau auf %(limit)s Zeilen begrenzt"

#: pretix_custom_reports/views/editor.py:254
msgid "Loading preview …"
msgstr "Vorschau wird geladen …"

#: pretix_custom_reports/views/editor.py:255
msgid "Automatic preview is off."
msgstr "Die automatische Vorschau ist aus."

#: pretix_custom_reports/views/editor.py:256
msgid "Showing %(shown)s of %(total)s rows"
msgstr "%(shown)s von %(total)s Zeilen werden angezeigt"

#: pretix_custom_reports/views/editor.py:257
msgid "Remove"
msgstr "Entfernen"

#: pretix_custom_reports/views/editor.py:258
msgid "Remove group"
msgstr "Gruppe entfernen"

#: pretix_custom_reports/views/editor.py:259
msgid "Separator between the joined values"
msgstr "Trennzeichen zwischen den zusammengefügten Werten"

#: pretix_custom_reports/views/editor.py:261
msgid "The report refers to fields in a way this event does not allow."
msgstr ""
"Die Auswertung verweist auf Felder in einer Weise, die diese Veranstaltung "
"nicht zulässt."

#: pretix_custom_reports/views/editor.py:263
msgid "The preview could not be executed."
msgstr "Die Vorschau konnte nicht ausgeführt werden."

#: pretix_custom_reports/views/editor.py:265
msgid "The report refers to fields that do not exist here."
msgstr "Die Auswertung verweist auf Felder, die es hier nicht gibt."

#: pretix_custom_reports/views/editor.py:268
msgid "The editor sent something the server could not read."
msgstr "Der Editor hat etwas geschickt, das der Server nicht lesen konnte."

#: pretix_custom_reports/views/editor.py:270
msgid "The report definition is not valid."
msgstr "Die Auswertungs-Definition ist nicht gültig."

#: pretix_custom_reports/views/editor.py:271
msgid "unknown"
msgstr "unbekannt"

#: pretix_custom_reports/views/editor.py:273
msgid "no value needed"
msgstr "kein Wert nötig"

#: pretix_custom_reports/views/editor.py:274
msgid "Warnings"
msgstr "Warnungen"

#: pretix_custom_reports/views/editor.py:520
msgid ""
"That event cannot be used as a reference: it does not exist, this plugin is "
"not enabled for it, or you may not view its orders. Please pick one of the "
"events below."
msgstr ""
"Diese Veranstaltung kann nicht als Referenz verwendet werden: Sie existiert "
"nicht, dieses Plugin ist für sie nicht aktiviert, oder Sie dürfen ihre "
"Bestellungen nicht ansehen. Bitte wählen Sie eine der folgenden "
"Veranstaltungen."

#: pretix_custom_reports/views/portability.py:167
msgid "This report cannot be exported: %(problem)s"
msgstr "Diese Auswertung kann nicht exportiert werden: %(problem)s"

#: pretix_custom_reports/views/portability.py:226
msgid "The file is larger than %(kib)s KiB."
msgstr "Die Datei ist größer als %(kib)s KiB."

#: pretix_custom_reports/views/portability.py:237
msgid "The file is not UTF-8 encoded text. Report files are JSON."
msgstr ""
"Die Datei ist kein UTF-8-kodierter Text. Auswertungs-Dateien sind JSON."

#: pretix_custom_reports/views/portability.py:262
msgid "Please choose a file or paste a report definition."
msgstr ""
"Bitte wählen Sie eine Datei aus oder fügen Sie eine Auswertungs-Definition "
"ein."

#: pretix_custom_reports/views/portability.py:304
msgid ""
"This report cannot be imported as it is. Please choose how to deal with the "
"fields listed below."
msgstr ""
"Diese Auswertung kann so nicht importiert werden. Bitte entscheiden Sie, wie "
"mit den unten aufgeführten Feldern umgegangen werden soll."

#: pretix_custom_reports/views/templates.py:178
#: pretix_custom_reports/views/templates.py:337
msgid "The requested template does not exist."
msgstr "Die angeforderte Vorlage existiert nicht."

#: pretix_custom_reports/views/templates.py:233
msgid "The template has been created."
msgstr "Die Vorlage wurde angelegt."

#: pretix_custom_reports/views/templates.py:276
msgid "The template has been deleted."
msgstr "Die Vorlage wurde gelöscht."

#: pretix_custom_reports/views/templates.py:300
msgid "This template cannot be exported: %(problem)s"
msgstr "Diese Vorlage kann nicht exportiert werden: %(problem)s"

#: pretix_custom_reports/views/templates.py:409
msgid ""
"This template cannot be loaded as it is. Please choose how to deal with the "
"fields listed below."
msgstr ""
"Diese Vorlage kann so nicht geladen werden. Bitte entscheiden Sie, wie mit "
"den unten aufgeführten Feldern umgegangen werden soll."

#: pretix_custom_reports/views/templates.py:421
msgid "The template has been loaded into this event."
msgstr "Die Vorlage wurde in diese Veranstaltung geladen."
