#: pretix_custom_reports/apps.py:23
msgid "Custom Reports"
msgstr "Custom Reports"

#: pretix_custom_reports/apps.py:26
msgid ""
"Define your own reports on orders and order positions in a graphical editor, "
"save them, reuse them, schedule them and share them as organizer-level "
"templates."
msgstr ""
"Definieren Sie eigene Auswertungen über Bestellungen und Bestellpositionen in"
" einem grafischen Editor, speichern Sie sie, verwenden Sie sie wieder, lassen"
" Sie sie terminiert laufen und teilen Sie sie als Vorlagen auf Veranstalter-"
"Ebene."

#: pretix_custom_reports/apps.py:45 pretix_custom_reports/models.py:264
#: pretix_custom_reports/signals.py:79
#: pretix_custom_reports/templates/pretix_custom_reports/report_list.html:23
#: pretix_custom_reports/templates/pretix_custom_reports/report_list.html:25
msgid "Reports"
msgstr "Auswertungen"

#: pretix_custom_reports/exporters.py:336
#: pretix_custom_reports/exporters.py:642
#: pretix_custom_reports/registry/choices.py:209
#: pretix_custom_reports/views/editor.py:275
msgid "Yes"
msgstr "Ja"

#: pretix_custom_reports/exporters.py:336
#: pretix_custom_reports/exporters.py:643
#: pretix_custom_reports/registry/choices.py:209
#: pretix_custom_reports/views/editor.py:247
msgid "No"
msgstr "Nein"

#: pretix_custom_reports/exporters.py:526
msgid "Custom report"
msgstr "Eigene Auswertung"

#: pretix_custom_reports/exporters.py:527
msgctxt "export_category"
msgid "Custom reports"
msgstr "Eigene Auswertungen"

#: pretix_custom_reports/exporters.py:529
msgid ""
"Run one of the reports you defined in the report editor. Relative date "
"filters such as \"last 30 days\" are evaluated when the export runs, so a "
"scheduled export keeps producing a current result."
msgstr ""
"Führen Sie eine der Auswertungen aus, die Sie im Auswertungs-Editor definiert"
" haben. Relative Datumsfilter wie „letzte 30 Tage“ werden beim Ausführen des "
"Exports berechnet, ein terminierter Export liefert also immer ein aktuelles "
"Ergebnis."

#: pretix_custom_reports/exporters.py:580 pretix_custom_reports/models.py:263
msgid "Report"
msgstr "Auswertung"

#: pretix_custom_reports/exporters.py:588
msgid ""
"Reports are matched by their internal identifier, so the same report can be "
"exported across several events."
msgstr ""
"Auswertungen werden über ihren internen Bezeichner zugeordnet, dieselbe "
"Auswertung kann deshalb über mehrere Veranstaltungen hinweg exportiert "
"werden."

#: pretix_custom_reports/exporters.py:592
msgid "One of the reports saved for this event."
msgstr "Eine der Auswertungen, die für diese Veranstaltung gespeichert sind."

#: pretix_custom_reports/exporters.py:596
#: pretix_custom_reports/templates/pretix_custom_reports/editor.html:344
msgid "Include canceled positions"
msgstr "Stornierte Positionen einschließen"

#: pretix_custom_reports/exporters.py:600
#: pretix_custom_reports/exporters.py:608
msgid "Overrides the setting saved with the report, for this run only."
msgstr ""
"Überschreibt die mit der Auswertung gespeicherte Einstellung, nur für diesen "
"Lauf."

#: pretix_custom_reports/exporters.py:604
#: pretix_custom_reports/templates/pretix_custom_reports/editor.html:356
msgid "Include test mode orders"
msgstr "Bestellungen im Testmodus einschließen"

#: pretix_custom_reports/exporters.py:612
#: pretix_custom_reports/templates/pretix_custom_reports/editor.html:360
msgid "Maximum number of rows"
msgstr "Maximale Zeilenzahl"

#: pretix_custom_reports/exporters.py:617
msgid ""
"Leave empty to use the limit saved with the report. Scheduled exports are "
"capped at 20 MB by pretix, so a large report needs a limit here to arrive at "
"all."
msgstr ""
"Leer lassen, um die mit der Auswertung gespeicherte Grenze zu verwenden. "
"Terminierte Exporte sind von pretix auf 20 MB begrenzt, eine große Auswertung"
" braucht hier also eine Grenze, um überhaupt anzukommen."

#: pretix_custom_reports/exporters.py:624
msgid "If an event cannot supply this report"
msgstr "Wenn eine Veranstaltung diese Auswertung nicht liefern kann"

#: pretix_custom_reports/exporters.py:627
msgid "Skip the event and export the rest"
msgstr "Veranstaltung überspringen und den Rest exportieren"

#: pretix_custom_reports/exporters.py:628
msgid "Fail the whole export"
msgstr "Den ganzen Export abbrechen"

#: pretix_custom_reports/exporters.py:632
msgid ""
"An event may not have this report at all, or a column may refer to a question"
" that does not exist there."
msgstr ""
"Eine Veranstaltung hat diese Auswertung vielleicht gar nicht, oder eine "
"Spalte verweist auf eine Frage, die es dort nicht gibt."

#: pretix_custom_reports/exporters.py:641
msgid "Use the setting saved with the report"
msgstr "Die mit der Auswertung gespeicherte Einstellung verwenden"

#: pretix_custom_reports/exporters.py:697
msgid ""
"This export cannot be written in the format \"{format}\". Please open the "
"export configuration and pick a format again."
msgstr ""
"Dieser Export kann nicht im Format „{format}“ geschrieben werden. Bitte "
"öffnen Sie die Export-Konfiguration und wählen Sie erneut ein Format."

#: pretix_custom_reports/exporters.py:719
msgid "There is no event you may run this export for."
msgstr ""
"Es gibt keine Veranstaltung, für die Sie diesen Export ausführen dürfen."

#: pretix_custom_reports/exporters.py:739
msgid ""
"The report \"{identifier}\" has {found} columns in event {event}, but "
"{expected} in the events before it."
msgstr ""
"Die Auswertung „{identifier}“ hat in der Veranstaltung {event} {found} "
"Spalten, in den Veranstaltungen davor aber {expected}."

#: pretix_custom_reports/exporters.py:769
msgid "This report could not be run for any of the selected events."
msgstr ""
"Diese Auswertung konnte für keine der ausgewählten Veranstaltungen ausgeführt"
" werden."

#: pretix_custom_reports/exporters.py:778
msgid "Event slug"
msgstr "Veranstaltungskürzel"

#: pretix_custom_reports/exporters.py:778
msgid "Event name"
msgstr "Veranstaltungsname"

#: pretix_custom_reports/exporters.py:829
msgid ""
"The report \"{identifier}\" cannot be exported for event {event}: the plugin "
"is not enabled for this event."
msgstr ""
"Die Auswertung „{identifier}“ kann für die Veranstaltung {event} nicht "
"exportiert werden: Das Plugin ist für diese Veranstaltung nicht aktiviert."

#: pretix_custom_reports/exporters.py:848
msgid ""
"The report \"{identifier}\" does not exist in event {event}. It was probably "
"deleted or renamed after this export was configured."
msgstr ""
"Die Auswertung „{identifier}“ existiert in der Veranstaltung {event} nicht. "
"Sie wurde vermutlich gelöscht oder umbenannt, nachdem dieser Export "
"eingerichtet wurde."

#: pretix_custom_reports/exporters.py:865
msgid "The report \"{name}\" cannot be run for event {event}: {error}"
msgstr ""
"Die Auswertung „{name}“ kann für die Veranstaltung {event} nicht ausgeführt "
"werden: {error}"

#: pretix_custom_reports/exporters.py:938
msgid ""
"No report was selected for this export, or the stored selection is not a "
"valid report identifier."
msgstr ""
"Für diesen Export wurde keine Auswertung ausgewählt, oder die gespeicherte "
"Auswahl ist kein gültiger Auswertungs-Bezeichner."

#: pretix_custom_reports/exporters.py:952
msgid "The stored value \"{value}\" for option \"{option}\" is not one of yes/no."
msgstr ""
"Der gespeicherte Wert „{value}“ für die Option „{option}“ ist weder yes noch "
"no."

#: pretix_custom_reports/exporters.py:976
msgid ""
"The stored row limit \"{value}\" is not a whole number between 1 and "
"{maximum}."
msgstr ""
"Die gespeicherte Zeilengrenze „{value}“ ist keine ganze Zahl zwischen 1 und "
"{maximum}."

#: pretix_custom_reports/forms.py:171
msgid "This identifier is already in use here. Please choose a different one."
msgstr ""
"Dieser Bezeichner wird hier bereits verwendet. Bitte wählen Sie einen "
"anderen."

#: pretix_custom_reports/forms.py:207
msgid ""
"The selected base does not match the base inside the definition "
"(%(definition_base)s)."
msgstr ""
"Die gewählte Basis passt nicht zur Basis innerhalb der Definition "
"(%(definition_base)s)."

#: pretix_custom_reports/models.py:169 pretix_custom_reports/views/api.py:223
msgid "One row per order"
msgstr "Eine Zeile je Bestellung"

#: pretix_custom_reports/models.py:170 pretix_custom_reports/views/api.py:224
msgid "One row per order position"
msgstr "Eine Zeile je Bestellposition"

